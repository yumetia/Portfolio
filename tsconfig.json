{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@context/*": ["src/context/*"],
      "@components/*": ["src/components/*"],
      "@assets/*": ["src/assets/*"],
      "@locales/*": ["src/locales/*"],
      "@utils/*": ["src/utils/*"],
    },

    "types": ["node"]
  }
}
